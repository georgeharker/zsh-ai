#!/usr/bin/env zsh
# bin/zsh-ai-view — modal viewer for streamed thinking output.
#
# Spawned by scratchpad widgets (planned: Alt-V) to present the bridge's
# thinking-output log file in an alt-screen modal box with scroll, follow,
# and auto-dismiss on a done-flag.
#
# Setup: `uv sync` in the plugin directory.

exec "${0:A:h:h}/.venv/bin/python" -m zsh_ai.view "$@"
